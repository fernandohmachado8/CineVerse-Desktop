{
  "name": "cineverse-desktop",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190 --strictPort",
    "build": "tsc --noEmit && vite build",
    "icons": "tauri icon app-icon.svg",
    "pretauri": "npm run icons",
    "tauri": "tauri",
    "test": "vitest run",
    "format": "prettier --write src tests/app.test.tsx index.html vite.config.ts tsconfig.json package.json .github/workflows",
    "format:check": "prettier --check src tests/app.test.tsx index.html vite.config.ts tsconfig.json package.json .github/workflows"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "lucide-react": "^0.468",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "jsdom": "^26",
    "prettier": "3.9.10",
    "typescript": "^5.9",
    "vite": "^7",
    "vitest": "^5.0.5"
  }
}
