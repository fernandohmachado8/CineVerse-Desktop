{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CineVerse Subtitle Preview",
  "version": "0.10.0",
  "identifier": "com.cineverse.desktop.subtitlepreview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5190",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CineVerse Subtitle Preview",
        "width": 1220,
        "height": 860,
        "minWidth": 940,
        "minHeight": 720,
        "backgroundColor": "#101417"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../worker/hdr_sei.py": "worker/hdr_sei.py",
      "../worker/hdr_trial.py": "worker/hdr_trial.py",
      "../worker/interpolate_hdr_rife.py": "worker/interpolate_hdr_rife.py",
      "../worker/interpolate_rife.py": "worker/interpolate_rife.py",
      "../worker/iw3_export.py": "worker/iw3_export.py",
      "../worker/pipeline.py": "worker/pipeline.py",
      "../worker/worker.py": "worker/worker.py",
      "../worker/media_import.py": "worker/media_import.py",
      "../worker/subtitles.py": "worker/subtitles.py",
      "../worker/protection.py": "worker/protection.py",
      "../worker/engine_setup.py": "worker/engine_setup.py",
      "../worker/cpu_session.ps1": "worker/cpu_session.ps1",
      "../thermal/thermal_guard.py": "thermal/thermal_guard.py",
      "../worker/hardware.py": "worker/hardware.py",
      "../scripts/setup_engine.py": "scripts/setup_engine.py",
      "../scripts/hardware_probe.ps1": "scripts/hardware_probe.ps1",
      "../scripts/hardware_detect.py": "scripts/hardware_detect.py",
      "../scripts/runtime_probe.py": "scripts/runtime_probe.py",
      "../requirements/engine-manifest.json": "requirements/engine-manifest.json",
      "../requirements/engine-win-py312.txt": "requirements/engine-win-py312.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../LICENSE": "LICENSE",
      "../worker/macos_platform.py": "worker/macos_platform.py",
      "../worker/mps_compat.py": "worker/mps_compat.py",
      "../worker/amd.py": "worker/amd.py",
      "../scripts/setup_macos.py": "scripts/setup_macos.py",
      "../requirements/engine-macos-py312.txt": "requirements/engine-macos-py312.txt"
    },
    "shortDescription": "Local 2D to stereoscopic movie conversion",
    "category": "Video",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
